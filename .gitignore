# ══════════════════════════════════════
# VideoStream — .gitignore
# MERN Stack + PostgreSQL
# ══════════════════════════════════════

# ── Environment Variables (NEVER commit these) ──
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local


# ── Node Modules ──
node_modules/
frontend/node_modules/
backend/node_modules/

# ── Build Output ──
frontend/build/
frontend/dist/
backend/dist/

# ── Logs ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Runtime & Cache ──
.npm/
.eslintcache
.stylelintcache
.cache/
.parcel-cache/
*.tsbuildinfo

# ── Uploads / User Media (store in cloud, not git) ──
backend/uploads/
public/uploads/
*.mp4
*.mov
*.avi
*.mkv
*.webm

# ── OS Files ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDE & Editor ──
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# ── Testing ──
coverage/
.nyc_output/
jest_html_reporters_*

# ── Misc ──
*.pem
*.key
*.cert
.yarn-integrity
.node_repl_history
*.tgz
*.zip